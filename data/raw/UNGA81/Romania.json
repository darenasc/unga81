[{"text": "The assembly will now hear an address by", "start": 2.8, "duration": 6.0}, {"text": "his excellency", "start": 6.56, "duration": 5.44}, {"text": "Nikicoar Daniel Dan, President of", "start": 8.8, "duration": 6.16}, {"text": "Romania. I request protocol to escort", "start": 12.0, "duration": 5.44}, {"text": "his excellency and invite him to address", "start": 14.96, "duration": 5.72}, {"text": "the assembly.", "start": 17.44, "duration": 3.24}, {"text": "Mr. President, Mr. Secretary", "start": 30.48, "duration": 5.239}, {"text": "pleasure to do so here in the United", "start": 45.2, "duration": 4.56}, {"text": "States,", "start": 47.76, "duration": 5.279}, {"text": "a country with which", "start": 49.76, "duration": 5.2}, {"text": "Romania share a long history of", "start": 53.039, "duration": 4.481}, {"text": "friendship, a nation towards which", "start": 54.96, "duration": 4.72}, {"text": "Romanians look with respect and", "start": 57.52, "duration": 4.08}, {"text": "gratitude,", "start": 59.68, "duration": 3.039}, {"text": "including", "start": 61.6, "duration": 3.68}, {"text": "for his essential contribution to the", "start": 62.719, "duration": 6.481}, {"text": "fall of the iron carton", "start": 65.28, "duration": 7.12}, {"text": "and the opening of my country's path", "start": 69.2, "duration": 8.04}, {"text": "towards democracy and freedom.", "start": 72.4, "duration": 4.84}, {"text": "We are at the United Nations and I will", "start": 77.92, "duration": 6.879}, {"text": "speak about relation between nations.", "start": 81.04, "duration": 6.399}, {"text": "But let me first draw your attention to", "start": 84.799, "duration": 5.521}, {"text": "a threat to our democracies", "start": 87.439, "duration": 5.281}, {"text": "that I do not believe it's receiving the", "start": 90.32, "duration": 5.52}, {"text": "interest it deserves.", "start": 92.72, "duration": 7.759}, {"text": "Manipulation via social media.", "start": 95.84, "duration": 7.04}, {"text": "The fundamental principle of democracy", "start": 100.479, "duration": 9.28}, {"text": "is one person, one voice, one vote.", "start": 102.88, "duration": 10.64}, {"text": "But if thousands of fake accounts speak", "start": 109.759, "duration": 6.64}, {"text": "in a coordinating manner,", "start": 113.52, "duration": 6.0}, {"text": "the in individual voice is no longer", "start": 116.399, "duration": 4.641}, {"text": "heard", "start": 119.52, "duration": 6.0}, {"text": "and freedom of speech is denied.", "start": 121.04, "duration": 7.439}, {"text": "And if thousands of fake accounts launch", "start": 125.52, "duration": 5.6}, {"text": "a coordinated attack", "start": 128.479, "duration": 7.201}, {"text": "on the ideas expressed by an individual,", "start": 131.12, "duration": 7.44}, {"text": "they discourage others from joining that", "start": 135.68, "duration": 6.32}, {"text": "person's cause and freedom of", "start": 138.56, "duration": 7.2}, {"text": "association is denied.", "start": 142.0, "duration": 6.92}, {"text": "I will", "start": 145.76, "duration": 3.16}, {"text": "The same principles that underpin", "start": 161.68, "duration": 4.639}, {"text": "international law,", "start": 163.92, "duration": 4.399}, {"text": "human rights,", "start": 166.319, "duration": 3.92}, {"text": "the rule of law, and democratic", "start": 168.319, "duration": 3.761}, {"text": "governance", "start": 170.239, "duration": 5.36}, {"text": "are the principles that helped transform", "start": 172.08, "duration": 6.48}, {"text": "my country. Romania's evolution over the", "start": 175.599, "duration": 5.681}, {"text": "past 37 years proves the crucial", "start": 178.56, "duration": 4.56}, {"text": "importance of upholding these", "start": 181.28, "duration": 3.92}, {"text": "principles.", "start": 183.12, "duration": 4.72}, {"text": "Millions of Romanians known from their", "start": 185.2, "duration": 4.24}, {"text": "personal experience the difference", "start": 187.84, "duration": 3.92}, {"text": "between a communist system system that", "start": 189.44, "duration": 4.799}, {"text": "oppressed them and stifled their", "start": 191.76, "duration": 6.479}, {"text": "initiative and freedom of choice", "start": 194.239, "duration": 7.36}, {"text": "and a democracy that rewards work,", "start": 198.239, "duration": 7.961}, {"text": "innovation and personal responsibility.", "start": 201.599, "duration": 4.601}, {"text": "This choice has turned Romania into one", "start": 206.4, "duration": 5.119}, {"text": "of Europe's most dynamic destinations in", "start": 208.64, "duration": 4.879}, {"text": "Europe for investment in and industrial", "start": 211.519, "duration": 3.761}, {"text": "development.", "start": 213.519, "duration": 4.72}, {"text": "Romania has aligned itself with the", "start": 215.28, "duration": 6.84}, {"text": "standards of the OECD.", "start": 218.239, "duration": 3.881}, {"text": "Leading global companies have", "start": 222.4, "duration": 3.52}, {"text": "established manufacturing, engineering,", "start": 223.92, "duration": 4.0}, {"text": "technology and service centers in my", "start": 225.92, "duration": 5.039}, {"text": "country attracted by our conducive", "start": 227.92, "duration": 6.0}, {"text": "business environment and highly skilled", "start": 230.959, "duration": 5.681}, {"text": "workforce.", "start": 233.92, "duration": 2.72}, {"text": "Our most important strategic asset is", "start": 236.72, "duration": 5.2}, {"text": "our people. Romanian scientists,", "start": 239.439, "duration": 4.88}, {"text": "engineers, physicians, and technology", "start": 241.92, "duration": 4.48}, {"text": "specialists", "start": 244.319, "duration": 4.321}, {"text": "are shaping the indust industries of the", "start": 246.4, "duration": 4.88}, {"text": "future. Artificial intelligence, cyber", "start": 248.64, "duration": 4.56}, {"text": "security,", "start": 251.28, "duration": 4.4}, {"text": "defense technologies,", "start": 253.2, "duration": 6.879}, {"text": "advanced manufacturing, and robotics.", "start": 255.68, "duration": 7.04}, {"text": "Moreover, Romania is stren strengthening", "start": 260.079, "duration": 5.12}, {"text": "Europe's resilience. We are developing", "start": 262.72, "duration": 5.36}, {"text": "significant reserves of natural gas,", "start": 265.199, "duration": 4.961}, {"text": "critical minerals and other strategic", "start": 268.08, "duration": 3.6}, {"text": "resources", "start": 270.16, "duration": 4.8}, {"text": "essential for securing supply chains and", "start": 271.68, "duration": 5.6}, {"text": "reducing dependence on unpredictable", "start": 274.96, "duration": 5.44}, {"text": "energy sources.", "start": 277.28, "duration": 7.44}, {"text": "Next year we will begin extracting", "start": 280.4, "duration": 6.64}, {"text": "exploiting 100 billion cubic meters of", "start": 284.72, "duration": 6.56}, {"text": "natural gas in the Black Sea.", "start": 287.04, "duration": 6.8}, {"text": "Romania is a gateway between Europe and", "start": 291.28, "duration": 5.52}, {"text": "the rest of the world. Located at the", "start": 293.84, "duration": 4.56}, {"text": "intersection of the Danube, the Black", "start": 296.8, "duration": 6.0}, {"text": "Sea and major trade corridors,", "start": 298.4, "duration": 7.359}, {"text": "my country serves as strategic hub for", "start": 302.8, "duration": 7.16}, {"text": "trade, energy and transport.", "start": 305.759, "duration": 4.201}, {"text": "Economic growth is all the stronger when", "start": 310.72, "duration": 6.96}, {"text": "it is based on partnership.", "start": 314.56, "duration": 6.639}, {"text": "Our message is simple. Romania is open", "start": 317.68, "duration": 6.32}, {"text": "to business and innovation.", "start": 321.199, "duration": 6.641}, {"text": "We are a credible and reliable partner", "start": 324.0, "duration": 6.0}, {"text": "ready to contribute to shared", "start": 327.84, "duration": 5.16}, {"text": "prosperity.", "start": 330.0, "duration": 3.0}, {"text": "Ladies and gentlemen,", "start": 333.6, "duration": 4.4}, {"text": "we have entered the fifth year of the", "start": 335.919, "duration": 4.881}, {"text": "illegal, unprovoked,", "start": 338.0, "duration": 5.68}, {"text": "and unjustified fullscale war of", "start": 340.8, "duration": 4.48}, {"text": "aggression", "start": 343.68, "duration": 4.4}, {"text": "against Ukraine waged by a permanent", "start": 345.28, "duration": 6.8}, {"text": "member of the security council.", "start": 348.08, "duration": 5.92}, {"text": "This member", "start": 352.08, "duration": 4.959}, {"text": "entrusted by the entire UN community", "start": 354.0, "duration": 5.12}, {"text": "with the responsibility of maintaining", "start": 357.039, "duration": 5.761}, {"text": "international peace and security", "start": 359.12, "duration": 6.24}, {"text": "has deliberately disavowed its", "start": 362.8, "duration": 5.2}, {"text": "fundamental fundamental obligation and", "start": 365.36, "duration": 6.88}, {"text": "is pursuing a revisionist agenda.", "start": 368.0, "duration": 6.72}, {"text": "As the EU member state sharing the", "start": 372.24, "duration": 4.88}, {"text": "longest border with Ukraine,", "start": 374.72, "duration": 5.84}, {"text": "Romania has felt the effects of this war", "start": 377.12, "duration": 5.28}, {"text": "directly.", "start": 380.56, "duration": 4.0}, {"text": "through repeated violations of our", "start": 382.4, "duration": 4.72}, {"text": "airspace.", "start": 384.56, "duration": 5.84}, {"text": "A few months back, a drone crashed onto", "start": 387.12, "duration": 6.24}, {"text": "a residential building on our territory,", "start": 390.4, "duration": 5.359}, {"text": "injuring people and causing material", "start": 393.36, "duration": 4.0}, {"text": "damage.", "start": 395.759, "duration": 4.56}, {"text": "It was one episode in an ongoing series", "start": 397.36, "duration": 5.36}, {"text": "of such incidents.", "start": 400.319, "duration": 4.481}, {"text": "We have said it before and we will say", "start": 402.72, "duration": 4.64}, {"text": "it again. Romania will stand with", "start": 404.8, "duration": 6.72}, {"text": "Ukraine and its people as they exercise", "start": 407.36, "duration": 6.48}, {"text": "their legitimate right to self-defense", "start": 411.52, "duration": 5.2}, {"text": "for as long as necessary.", "start": 413.84, "duration": 5.919}, {"text": "Moreover, Romania is acting responsibly", "start": 416.72, "duration": 6.08}, {"text": "to stabilize the region.", "start": 419.759, "duration": 6.56}, {"text": "We provided assistance to refugees from", "start": 422.8, "duration": 5.679}, {"text": "Ukraine", "start": 426.319, "duration": 4.32}, {"text": "in response to Russia's attacks on ports", "start": 428.479, "duration": 4.881}, {"text": "and grain infrastructure,", "start": 430.639, "duration": 4.801}, {"text": "which disrupted global food supply", "start": 433.36, "duration": 3.679}, {"text": "chains", "start": 435.44, "duration": 4.08}, {"text": "and deepened food insecurity for", "start": 437.039, "duration": 5.841}, {"text": "millions of people. Romania has", "start": 439.52, "duration": 5.36}, {"text": "coordinated with Ukraine on the transit", "start": 442.88, "duration": 5.439}, {"text": "of grain through Romania by rail and by", "start": 444.88, "duration": 6.439}, {"text": "waterway.", "start": 448.319, "duration": 3.0}, {"text": "In response to the disruption of freedom", "start": 451.52, "duration": 4.399}, {"text": "of navigation in the Black Sea, together", "start": 453.52, "duration": 4.799}, {"text": "with Bulgaria and Turkey, Romania is", "start": 455.919, "duration": 4.641}, {"text": "part of the mine countermeasures task", "start": 458.319, "duration": 6.16}, {"text": "group in the Black Sea", "start": 460.56, "duration": 6.24}, {"text": "through mine detection and mine", "start": 464.479, "duration": 3.84}, {"text": "neutralization missions and the", "start": 466.8, "duration": 3.119}, {"text": "protection of critical undersea", "start": 468.319, "duration": 3.361}, {"text": "infrastructure.", "start": 469.919, "duration": 4.0}, {"text": "This initiative safeguards freedom of", "start": 471.68, "duration": 4.239}, {"text": "navigation", "start": 473.919, "duration": 6.0}, {"text": "and the region's energy security.", "start": 475.919, "duration": 6.081}, {"text": "And in order to enhance security in the", "start": 479.919, "duration": 4.56}, {"text": "Black Sea area, Romania places", "start": 482.0, "duration": 5.12}, {"text": "particular emphasis on the EU strategic", "start": 484.479, "duration": 4.16}, {"text": "approach.", "start": 487.12, "duration": 3.519}, {"text": "Accordingly, together with Bulgaria, we", "start": 488.639, "duration": 4.96}, {"text": "are establishing a maritime security hub", "start": 490.639, "duration": 5.28}, {"text": "aimed at strengthening situational", "start": 493.599, "duration": 5.32}, {"text": "awareness.", "start": 495.919, "duration": 3.0}, {"text": "Finally, in response to disruptions to", "start": 500.0, "duration": 6.24}, {"text": "energy supplies in the region, Romania", "start": 503.599, "duration": 5.361}, {"text": "has expanded its energy interconnections", "start": 506.24, "duration": 4.239}, {"text": "with Ukraine and the Republic of", "start": 508.96, "duration": 4.16}, {"text": "Muldova.", "start": 510.479, "duration": 5.281}, {"text": "Romania will continue to support the", "start": 513.12, "duration": 4.96}, {"text": "resilience of our neighbor, the Republic", "start": 515.76, "duration": 4.56}, {"text": "of Moldova,", "start": 518.08, "duration": 4.639}, {"text": "the second most affected country by this", "start": 520.32, "duration": 4.8}, {"text": "war.", "start": 522.719, "duration": 5.441}, {"text": "It is facing the economic shock caused", "start": 525.12, "duration": 6.64}, {"text": "by Russia's aggression and a sustained", "start": 528.16, "duration": 5.84}, {"text": "hybrid campaign", "start": 531.76, "duration": 4.48}, {"text": "consist consisting of disseminating", "start": 534.0, "duration": 4.64}, {"text": "disinformation, energy pressure and", "start": 536.24, "duration": 4.88}, {"text": "attempts to destabilize its democratic", "start": 538.64, "duration": 4.48}, {"text": "institutions.", "start": 541.12, "duration": 4.399}, {"text": "Romania is a staunch supporter of the", "start": 543.12, "duration": 4.96}, {"text": "Republic of Muldova in the face of these", "start": 545.519, "duration": 4.161}, {"text": "challenges.", "start": 548.08, "duration": 4.64}, {"text": "Romania also remains the Republic of", "start": 549.68, "duration": 5.12}, {"text": "Moldova's strongest advocate within the", "start": 552.72, "duration": 4.799}, {"text": "European Union, sharing our own", "start": 554.8, "duration": 5.44}, {"text": "experience of accession and providing", "start": 557.519, "duration": 4.401}, {"text": "political, technical, and diplomatic", "start": 560.24, "duration": 3.52}, {"text": "support", "start": 561.92, "duration": 5.68}, {"text": "for its European path.", "start": 563.76, "duration": 5.44}, {"text": "The threat posed by the Russian", "start": 567.6, "duration": 3.52}, {"text": "Federation is not only limited to", "start": 569.2, "duration": 5.36}, {"text": "Ukraine. Europe is the target of a", "start": 571.12, "duration": 7.92}, {"text": "hybrid war involving cyber attacks,", "start": 574.56, "duration": 6.8}, {"text": "disinformation campaigns, sabotage and", "start": 579.04, "duration": 5.359}, {"text": "disruptions to critical infrastructure", "start": 581.36, "duration": 5.76}, {"text": "with the aim of undermining citizens", "start": 584.399, "duration": 6.241}, {"text": "trust in democratic institutions", "start": 587.12, "duration": 8.399}, {"text": "and discouraging support for Ukraine.", "start": 590.64, "duration": 8.24}, {"text": "We must deter the Russian threat and", "start": 595.519, "duration": 5.76}, {"text": "unfortunately we can only do that by", "start": 598.88, "duration": 5.44}, {"text": "increasing military spending. Romania", "start": 601.279, "duration": 6.161}, {"text": "supports balancing military expenditure", "start": 604.32, "duration": 7.68}, {"text": "and the target of 5% of GDP", "start": 607.44, "duration": 8.48}, {"text": "reaching this year 3.7%.", "start": 612.0, "duration": 6.399}, {"text": "Distinguished", "start": 615.92, "duration": 4.0}, {"text": "audience,", "start": 618.399, "duration": 4.321}, {"text": "we are equally concerned about the", "start": 619.92, "duration": 6.72}, {"text": "proliferation of conflicts worldwide.", "start": 622.72, "duration": 6.0}, {"text": "It is essential to advance the", "start": 626.64, "duration": 3.84}, {"text": "implementation of the peace plan for", "start": 628.72, "duration": 4.72}, {"text": "Gaza in accordance with security council", "start": 630.48, "duration": 5.919}, {"text": "resol resolution 2803", "start": 633.44, "duration": 5.839}, {"text": "and to address with no delay the", "start": 636.399, "duration": 5.521}, {"text": "humanitarian situation on the ground.", "start": 639.279, "duration": 4.481}, {"text": "Within the board of peace initiative,", "start": 641.92, "duration": 3.84}, {"text": "Romania has offered its support and has", "start": 643.76, "duration": 4.8}, {"text": "so far contributed to the medical", "start": 645.76, "duration": 5.12}, {"text": "evacuation of numerous patients,", "start": 648.56, "duration": 5.12}, {"text": "especially children.", "start": 650.88, "duration": 6.24}, {"text": "Disarming Hamas remains a prerequisite", "start": 653.68, "duration": 6.64}, {"text": "condition for lasting stability in Gaza.", "start": 657.12, "duration": 5.36}, {"text": "President Trump's peace plan represents", "start": 660.32, "duration": 4.079}, {"text": "the most credible path toward peace,", "start": 662.48, "duration": 4.08}, {"text": "peace, and prosperity in the region, and", "start": 664.399, "duration": 3.921}, {"text": "Romania supports its full", "start": 666.56, "duration": 3.68}, {"text": "implementation.", "start": 668.32, "duration": 4.48}, {"text": "At the same time, recent developments in", "start": 670.24, "duration": 5.279}, {"text": "the West Bank are a genuine reason for", "start": 672.8, "duration": 5.68}, {"text": "concern and risk undermining the peace", "start": 675.519, "duration": 7.121}, {"text": "that this plan seeks to promote.", "start": 678.48, "duration": 8.72}, {"text": "Regarding Iran, our position is clear.", "start": 682.64, "duration": 8.08}, {"text": "Iran must not possess a nuclear weapon.", "start": 687.2, "duration": 6.319}, {"text": "Iran must comply with the nuclear", "start": 690.72, "duration": 6.0}, {"text": "non-prolifer proliferation treaty.", "start": 693.519, "duration": 5.44}, {"text": "the security the safeguards of the", "start": 696.72, "duration": 4.559}, {"text": "International Atomic Energy Agency and", "start": 698.959, "duration": 4.56}, {"text": "restore full transparency regarding its", "start": 701.279, "duration": 4.401}, {"text": "nuclear program.", "start": 703.519, "duration": 4.32}, {"text": "Diplomacy must be the first option", "start": 705.68, "duration": 5.2}, {"text": "towards a comprehensive, verifiable and", "start": 707.839, "duration": 5.761}, {"text": "lasting agreement that would pave the", "start": 710.88, "duration": 5.36}, {"text": "way towards a more stable Middle East.", "start": 713.6, "duration": 4.32}, {"text": "Romania will continue to promote", "start": 716.24, "duration": 4.0}, {"text": "maritime security and unrestricted", "start": 717.92, "duration": 4.64}, {"text": "freedom of navigation in the Strait of", "start": 720.24, "duration": 4.4}, {"text": "Ormuz as well as in the Black Sea area", "start": 722.56, "duration": 4.0}, {"text": "and elsewhere.", "start": 724.64, "duration": 4.72}, {"text": "It is a shared responsibility", "start": 726.56, "duration": 6.0}, {"text": "and a priority to my country.", "start": 729.36, "duration": 4.96}, {"text": "Specialized bodies such as the", "start": 732.56, "duration": 4.64}, {"text": "International Maritime Organization can", "start": 734.32, "duration": 5.92}, {"text": "make a contribution to this effort.", "start": 737.2, "duration": 5.36}, {"text": "The suspension of the Black Sea Grain", "start": 740.24, "duration": 4.24}, {"text": "Initiative", "start": 742.56, "duration": 4.32}, {"text": "following Russia's unilateral withdrawal", "start": 744.48, "duration": 4.72}, {"text": "in 2023", "start": 746.88, "duration": 5.519}, {"text": "reminds us that agreements only matter", "start": 749.2, "duration": 4.879}, {"text": "when the parties honor their", "start": 752.399, "duration": 4.641}, {"text": "commitments.", "start": 754.079, "duration": 2.961}, {"text": "lasting peace in Sudan, South Sudan, the", "start": 763.2, "duration": 4.879}, {"text": "Democratic Republic of the Congo,", "start": 766.0, "duration": 6.24}, {"text": "Somalia, Libya, in the Sahel, and in all", "start": 768.079, "duration": 7.44}, {"text": "regions of Africa affected by conflict.", "start": 772.24, "duration": 6.88}, {"text": "Romania is contributing to conflict", "start": 775.519, "duration": 8.921}, {"text": "prevention, mediation, peaceuilding", "start": 779.12, "duration": 5.32}, {"text": "and economic recovery while stressing", "start": 784.56, "duration": 6.399}, {"text": "the importance of", "start": 787.44, "duration": 5.76}, {"text": "African solutions and in full respect of", "start": 790.959, "duration": 5.841}, {"text": "the charter prevention and mediation", "start": 793.2, "duration": 6.72}, {"text": "must play a greater role. Peacekeeping", "start": 796.8, "duration": 6.64}, {"text": "operations must have a clear mandate,", "start": 799.92, "duration": 6.56}, {"text": "produce measurable results, ensure", "start": 803.44, "duration": 5.04}, {"text": "responsible", "start": 806.48, "duration": 5.359}, {"text": "financing, and equitably distribute", "start": 808.48, "duration": 5.12}, {"text": "responsibilities.", "start": 811.839, "duration": 4.721}, {"text": "Since 1991,", "start": 813.6, "duration": 6.56}, {"text": "Romania has contributed to United", "start": 816.56, "duration": 6.24}, {"text": "Nations peacekeeping missions through", "start": 820.16, "duration": 5.04}, {"text": "political support,", "start": 822.8, "duration": 5.039}, {"text": "troop and equipment contributions as", "start": 825.2, "duration": 5.04}, {"text": "well as through training blue helmets", "start": 827.839, "duration": 6.641}, {"text": "and close protection officers.", "start": 830.24, "duration": 6.8}, {"text": "Romania also attaches great importance", "start": 834.48, "duration": 5.12}, {"text": "to the role of the international", "start": 837.04, "duration": 5.2}, {"text": "organization of LANI in promoting peace", "start": 839.6, "duration": 5.88}, {"text": "and security", "start": 842.24, "duration": 3.24}, {"text": "with the majority of its 90 members", "start": 846.56, "duration": 6.719}, {"text": "located in Africa. The OAF supports", "start": 849.6, "duration": 7.52}, {"text": "mediation, electoral monitoring and", "start": 853.279, "duration": 8.841}, {"text": "peace building in fragile context.", "start": 857.12, "duration": 5.0}, {"text": "Romania presented a candidate for the", "start": 862.399, "duration": 4.321}, {"text": "post of the secretary general of the", "start": 865.199, "duration": 4.88}, {"text": "OIF, a former prime minister", "start": 866.72, "duration": 6.799}, {"text": "and a prominent experience figure in", "start": 870.079, "duration": 6.481}, {"text": "international affairs. This candidature", "start": 873.519, "duration": 4.961}, {"text": "reflects", "start": 876.56, "duration": 5.04}, {"text": "Romania's will to put its experience to", "start": 878.48, "duration": 5.76}, {"text": "the service of uh ifi making it more", "start": 881.6, "duration": 4.4}, {"text": "strong and more efficient. We count on", "start": 884.24, "duration": 3.52}, {"text": "your support.", "start": 886.0, "duration": 4.48}, {"text": "Ladies and gentlemen, allow me to", "start": 887.76, "duration": 6.16}, {"text": "conclude by welcoming the initiatives of", "start": 890.48, "duration": 6.08}, {"text": "the first ladies and first gentlemen", "start": 893.92, "duration": 4.8}, {"text": "concerning children and education,", "start": 896.56, "duration": 4.16}, {"text": "innovation,", "start": 898.72, "duration": 6.479}, {"text": "digital education and children's safety.", "start": 900.72, "duration": 7.28}, {"text": "Romania has joined the initiatives", "start": 905.199, "duration": 6.32}, {"text": "launched by Melania Trump, Amin Erdogan,", "start": 908.0, "duration": 7.32}, {"text": "and Oena Zalinska.", "start": 911.519, "duration": 3.801}, {"text": "By building accessible education and", "start": 915.36, "duration": 5.919}, {"text": "creating a more innovative and safer", "start": 918.72, "duration": 5.28}, {"text": "environment for our children, we are", "start": 921.279, "duration": 4.401}, {"text": "building a better future for our", "start": 924.0, "duration": 5.8}, {"text": "societies. Thank you.", "start": 925.68, "duration": 4.12}, {"text": "On behalf of the assembly,", "start": 933.199, "duration": 4.481}, {"text": "I wish to thank the president of", "start": 935.839, "duration": 4.841}, {"text": "Romania.", "start": 937.68, "duration": 3.0}]