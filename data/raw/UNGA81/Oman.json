[{"text": "I now give the floor to his excellency", "start": 2.32, "duration": 6.56}, {"text": "said", "start": 6.799, "duration": 5.601}, {"text": "Badr bin Mhammed bin Hammud ali", "start": 8.88, "duration": 7.56}, {"text": "foreign minister of Aman", "start": 12.4, "duration": 4.04}, {"text": "thank", "start": 26.24, "duration": 2.16}, {"text": "Your Excellency, President of the 81st", "start": 42.16, "duration": 5.84}, {"text": "session of the United Nations General", "start": 46.0, "duration": 3.6}, {"text": "Assembly,", "start": 48.0, "duration": 5.52}, {"text": "heads and members of delegations,", "start": 49.6, "duration": 6.72}, {"text": "allow me to extend my sincere Sincere", "start": 53.52, "duration": 6.24}, {"text": "congratulations to his excellency Dr.", "start": 56.32, "duration": 6.239}, {"text": "Khalil Alraman on his election to", "start": 59.76, "duration": 5.28}, {"text": "preside over this session wishing him", "start": 62.559, "duration": 4.56}, {"text": "every success in carrying out his", "start": 65.04, "duration": 3.759}, {"text": "duties.", "start": 67.119, "duration": 5.241}, {"text": "Ladies and gentlemen,", "start": 68.799, "duration": 3.561}, {"text": "dialogue is the truest expression", "start": 72.4, "duration": 10.28}, {"text": "of what binds us together.", "start": 76.56, "duration": 6.12}, {"text": "It is also the optimal way to overcome", "start": 84.96, "duration": 6.159}, {"text": "differences,", "start": 89.439, "duration": 4.64}, {"text": "build trust and understanding", "start": 91.119, "duration": 4.96}, {"text": "and resolve", "start": 94.079, "duration": 5.0}, {"text": "crisis.", "start": 96.079, "duration": 3.0}, {"text": "The Sultenate of Oman", "start": 100.88, "duration": 6.0}, {"text": "will continue", "start": 104.0, "duration": 6.32}, {"text": "its steadfast approach to finding", "start": 106.88, "duration": 4.96}, {"text": "peaceful", "start": 110.32, "duration": 6.759}, {"text": "and consensual solutions to disputes", "start": 111.84, "duration": 5.239}, {"text": "based on the values and principles", "start": 117.28, "duration": 6.799}, {"text": "that help us achieve", "start": 121.52, "duration": 5.76}, {"text": "our shared goals", "start": 124.079, "duration": 5.361}, {"text": "of achieving security and stability for", "start": 127.28, "duration": 5.599}, {"text": "all and advancing economic development", "start": 129.44, "duration": 6.799}, {"text": "projects and prosperity, shared", "start": 132.879, "duration": 7.561}, {"text": "prosperity for our peoples.", "start": 136.239, "duration": 4.201}, {"text": "refraining", "start": 143.04, "duration": 4.88}, {"text": "from the use of force and interference", "start": 144.72, "duration": 7.48}, {"text": "in the internal affairs of states", "start": 147.92, "duration": 4.28}, {"text": "and being guided instead by the charter", "start": 152.239, "duration": 5.201}, {"text": "of the United Nations and international", "start": 155.36, "duration": 4.239}, {"text": "law", "start": 157.44, "duration": 3.84}, {"text": "and respecting the sovereignty and", "start": 159.599, "duration": 4.241}, {"text": "independence of states", "start": 161.28, "duration": 7.2}, {"text": "can provide a sound framework that", "start": 163.84, "duration": 8.88}, {"text": "governs international relations.", "start": 168.48, "duration": 6.64}, {"text": "and that builds trust and constructive", "start": 172.72, "duration": 5.599}, {"text": "cooperation among states,", "start": 175.12, "duration": 4.96}, {"text": "distinguished heads and members of", "start": 178.319, "duration": 3.761}, {"text": "delegations.", "start": 180.08, "duration": 5.56}, {"text": "Honorable delegates,", "start": 182.08, "duration": 3.56}, {"text": "at the beginning of this year,", "start": 189.12, "duration": 5.92}, {"text": "our region", "start": 192.159, "duration": 5.201}, {"text": "witnessed a war that could have been", "start": 195.04, "duration": 4.559}, {"text": "avoided.", "start": 197.36, "duration": 6.239}, {"text": "Subsequent events have shown", "start": 199.599, "duration": 7.121}, {"text": "that the escalation has extended to", "start": 203.599, "duration": 5.441}, {"text": "threaten the security of the countries", "start": 206.72, "duration": 5.04}, {"text": "of the region", "start": 209.04, "duration": 6.16}, {"text": "and paralyze navigation and trade", "start": 211.76, "duration": 6.96}, {"text": "through the vital strait of Hermuz", "start": 215.2, "duration": 6.88}, {"text": "affecting energy security, price", "start": 218.72, "duration": 6.64}, {"text": "stability and confidence in the current", "start": 222.08, "duration": 6.159}, {"text": "international order.", "start": 225.36, "duration": 6.239}, {"text": "The Sultenate of Oman once again", "start": 228.239, "duration": 6.801}, {"text": "reaffirms its steadfast commitment to", "start": 231.599, "duration": 5.84}, {"text": "continuing its efforts", "start": 235.04, "duration": 4.96}, {"text": "aimed at safeguarding navigation in the", "start": 237.439, "duration": 5.681}, {"text": "Strait of Hormuz", "start": 240.0, "duration": 5.2}, {"text": "in accordance with the principles of", "start": 243.12, "duration": 5.28}, {"text": "international law and the United Nations", "start": 245.2, "duration": 7.44}, {"text": "Convention on the Law of the Sea.", "start": 248.4, "duration": 8.48}, {"text": "We also call upon all parties to", "start": 252.64, "duration": 7.599}, {"text": "cooperate with Oman in these efforts", "start": 256.88, "duration": 8.16}, {"text": "aimed at safeguarding the interests of", "start": 260.239, "duration": 9.52}, {"text": "all parties relying on transit through", "start": 265.04, "duration": 7.68}, {"text": "the strait of Hormuz.", "start": 269.759, "duration": 5.601}, {"text": "The Sultenate of Aman", "start": 272.72, "duration": 7.039}, {"text": "renews its solidarity with all", "start": 275.36, "duration": 7.119}, {"text": "neighboring countries,", "start": 279.759, "duration": 6.0}, {"text": "including the member states of the Gulf", "start": 282.479, "duration": 7.081}, {"text": "Cooperation Council", "start": 285.759, "duration": 3.801}, {"text": "in the legitimate measures", "start": 289.759, "duration": 7.041}, {"text": "they take to maintain their security and", "start": 293.04, "duration": 5.52}, {"text": "protect their sovereignty and", "start": 296.8, "duration": 5.399}, {"text": "territorial integrity.", "start": 298.56, "duration": 3.639}, {"text": "At the same time,", "start": 303.919, "duration": 7.12}, {"text": "we call upon all parties concerned to", "start": 306.479, "duration": 8.72}, {"text": "settle their outstanding disputes", "start": 311.039, "duration": 6.88}, {"text": "through pursuing a POS policy of", "start": 315.199, "duration": 6.0}, {"text": "self-restraint and foresight", "start": 317.919, "duration": 6.401}, {"text": "and through engaging in dialogue", "start": 321.199, "duration": 6.481}, {"text": "to reach consensual", "start": 324.32, "duration": 6.96}, {"text": "political solutions. s", "start": 327.68, "duration": 6.32}, {"text": "and sustainable understandings", "start": 331.28, "duration": 6.84}, {"text": "for the benefit of all.", "start": 334.0, "duration": 4.12}, {"text": "The government of the Sultenate of Oman", "start": 339.12, "duration": 7.04}, {"text": "renews its support", "start": 342.32, "duration": 6.4}, {"text": "for reaching a political solution to the", "start": 346.16, "duration": 5.039}, {"text": "crisis in Yemen.", "start": 348.72, "duration": 7.759}, {"text": "one that preserves the unity,", "start": 351.199, "duration": 8.321}, {"text": "stability, and territorial integrity of", "start": 356.479, "duration": 5.761}, {"text": "this great country.", "start": 359.52, "duration": 6.64}, {"text": "One that meets the aspirations of all", "start": 362.24, "duration": 6.239}, {"text": "components of the brotherly Yemeni", "start": 366.16, "duration": 4.08}, {"text": "people.", "start": 368.479, "duration": 4.081}, {"text": "One that puts Yemen on the path of", "start": 370.24, "duration": 3.84}, {"text": "reconstruction, development, and", "start": 372.56, "duration": 3.6}, {"text": "prosperity.", "start": 374.08, "duration": 4.559}, {"text": "In this context,", "start": 376.16, "duration": 7.24}, {"text": "we renew our call", "start": 378.639, "duration": 4.761}, {"text": "upon all parties to cooperate with one", "start": 384.72, "duration": 7.0}, {"text": "another,", "start": 388.72, "duration": 3.0}, {"text": "to engage positively with one another,", "start": 391.84, "duration": 5.84}, {"text": "to reach a just settlement to this", "start": 394.96, "duration": 6.799}, {"text": "crisis, one that preserves the rights", "start": 397.68, "duration": 6.88}, {"text": "and dignity of the Yemeni people, one", "start": 401.759, "duration": 5.121}, {"text": "that preserves the independence and", "start": 404.56, "duration": 4.96}, {"text": "territorial integrity of Yemen and one", "start": 406.88, "duration": 5.2}, {"text": "that that ensures", "start": 409.52, "duration": 5.76}, {"text": "stable relations with neighboring states", "start": 412.08, "duration": 6.6}, {"text": "in the region.", "start": 415.28, "duration": 3.4}, {"text": "The Sultenate of Oman", "start": 419.28, "duration": 5.84}, {"text": "reaffirms", "start": 422.4, "duration": 6.0}, {"text": "its firm rejection", "start": 425.12, "duration": 8.359}, {"text": "of the ongoing Israeli attacks", "start": 428.4, "duration": 5.079}, {"text": "against numerous Arab states.", "start": 433.759, "duration": 4.44}, {"text": "We also express our condemnation of the", "start": 438.639, "duration": 6.96}, {"text": "crimes of the Israeli occupation", "start": 442.319, "duration": 5.841}, {"text": "and its increasing violations against", "start": 445.599, "duration": 6.44}, {"text": "the Palestinian people,", "start": 448.16, "duration": 3.879}, {"text": "which have compounded", "start": 453.599, "duration": 4.88}, {"text": "the suffering of the Palestinian people", "start": 455.759, "duration": 5.361}, {"text": "in its struggle to obtain its legitimate", "start": 458.479, "duration": 6.801}, {"text": "rights and liberate its land", "start": 461.12, "duration": 8.919}, {"text": "within the borders of June 4th. 1967", "start": 465.28, "duration": 4.759}, {"text": "based on the two-state solution and", "start": 472.479, "duration": 5.761}, {"text": "relevant United Nations resolutions.", "start": 474.4, "duration": 7.4}, {"text": "Honorable delegates,", "start": 478.24, "duration": 3.56}, {"text": "the Sultenate of Oman launched the", "start": 483.68, "duration": 6.079}, {"text": "Muscat plan", "start": 486.879, "duration": 7.361}, {"text": "to counter hate speech,", "start": 489.759, "duration": 7.201}, {"text": "genocide,", "start": 494.24, "duration": 6.079}, {"text": "atrocity crimes, and incitement to", "start": 496.96, "duration": 8.079}, {"text": "atrocity crimes through an initiative", "start": 500.319, "duration": 8.72}, {"text": "inaugurated by His Excellency the the", "start": 505.039, "duration": 6.401}, {"text": "Secretary General of the United Nations", "start": 509.039, "duration": 4.161}, {"text": "and with broad international", "start": 511.44, "duration": 4.32}, {"text": "participation here at United Nations", "start": 513.2, "duration": 6.56}, {"text": "headquarters in New York on the 11th", "start": 515.76, "duration": 7.8}, {"text": "of June 2026.", "start": 519.76, "duration": 3.8}, {"text": "Building on this approach,", "start": 524.159, "duration": 6.24}, {"text": "the city of Muscat", "start": 526.72, "duration": 7.679}, {"text": "will host next November, God willing, an", "start": 530.399, "duration": 7.521}, {"text": "event marking the International Day of", "start": 534.399, "duration": 6.521}, {"text": "Tolerance,", "start": 537.92, "duration": 3.0}, {"text": "as part of a path we hope will lead to", "start": 541.279, "duration": 10.201}, {"text": "further initiatives and partnerships", "start": 546.32, "duration": 5.16}, {"text": "in cooperation with international", "start": 552.0, "duration": 6.279}, {"text": "community and the United Nations.", "start": 554.24, "duration": 4.039}, {"text": "Ladies and gentlemen,", "start": 558.399, "duration": 3.481}, {"text": "the Sultenate of Oman attaches great", "start": 562.64, "duration": 5.6}, {"text": "importance to sustainable development", "start": 566.0, "duration": 6.519}, {"text": "and sustainable development goals.", "start": 568.24, "duration": 4.279}, {"text": "We believe that development is indeed an", "start": 575.2, "duration": 7.12}, {"text": "inherent right for all.", "start": 578.88, "duration": 5.92}, {"text": "My government", "start": 582.32, "duration": 4.72}, {"text": "continues to implement its development", "start": 584.8, "duration": 6.08}, {"text": "plans and programs within the Oman", "start": 587.04, "duration": 7.56}, {"text": "vision 2040.", "start": 590.88, "duration": 3.72}, {"text": "We also continue to empower women's", "start": 596.48, "duration": 6.72}, {"text": "active participation and contribution to", "start": 599.92, "duration": 5.2}, {"text": "the development process and decision", "start": 603.2, "duration": 4.56}, {"text": "making.", "start": 605.12, "duration": 4.48}, {"text": "Women", "start": 607.76, "duration": 5.199}, {"text": "are an integral part of the sustainable", "start": 609.6, "duration": 6.32}, {"text": "development process and should not be", "start": 612.959, "duration": 6.161}, {"text": "viewed solely as a goal of development", "start": 615.92, "duration": 6.2}, {"text": "efforts.", "start": 619.12, "duration": 3.0}, {"text": "We therefore", "start": 622.48, "duration": 4.72}, {"text": "allocated", "start": 624.399, "duration": 6.401}, {"text": "11 permanent and elected seats for women", "start": 627.2, "duration": 8.36}, {"text": "in the Omani Shura Council.", "start": 630.8, "duration": 4.76}, {"text": "In the environmental field, the", "start": 637.6, "duration": 4.64}, {"text": "Sultenate of Oman continues its efforts", "start": 639.6, "duration": 5.44}, {"text": "to implement its national strategy", "start": 642.24, "duration": 6.56}, {"text": "towards transition to a lowcarbon", "start": 645.04, "duration": 6.32}, {"text": "economy", "start": 648.8, "duration": 8.08}, {"text": "through a broad package of projects and", "start": 651.36, "duration": 10.84}, {"text": "initiatives in renewable energy", "start": 656.88, "duration": 5.32}, {"text": "and initiatives lives in transport", "start": 663.6, "duration": 6.32}, {"text": "industry and sustainable cities to", "start": 666.24, "duration": 7.92}, {"text": "support national efforts to reach carbon", "start": 669.92, "duration": 6.0}, {"text": "neutrality", "start": 674.16, "duration": 3.52}, {"text": "by", "start": 675.92, "duration": 4.76}, {"text": "2050.", "start": 677.68, "duration": 3.0}, {"text": "In conclusion,", "start": 682.959, "duration": 3.32}, {"text": "we once again express our gratitude and", "start": 689.76, "duration": 5.92}, {"text": "appreciation to His Excellency Antonio", "start": 692.72, "duration": 5.359}, {"text": "Guterish, Secretary General of the", "start": 695.68, "duration": 5.8}, {"text": "United Nations,", "start": 698.079, "duration": 3.401}, {"text": "for his tireless and courageous efforts", "start": 701.839, "duration": 8.24}, {"text": "to uphold truth and justice", "start": 706.32, "duration": 5.92}, {"text": "in accordance with the United Nations", "start": 710.079, "duration": 3.121}, {"text": "Charter.", "start": 712.24, "duration": 4.64}, {"text": "and international law.", "start": 713.2, "duration": 7.759}, {"text": "We affirm once again our support and", "start": 716.88, "duration": 8.72}, {"text": "cooperation with the United Nations", "start": 720.959, "duration": 10.161}, {"text": "to achieve its noble goals and purposes", "start": 725.6, "duration": 9.039}, {"text": "to establish a world that is more", "start": 731.12, "duration": 5.519}, {"text": "secure, more stable, and more", "start": 734.639, "duration": 4.241}, {"text": "prosperous. Thank you, and may the", "start": 736.639, "duration": 3.841}, {"text": "peace, mercy, and blessings of God be", "start": 738.88, "duration": 3.28}, {"text": "upon you.", "start": 740.48, "duration": 7.08}, {"text": "I thank the foreign minister of Oman.", "start": 742.16, "duration": 5.4}, {"text": "I now give the floor to her excellency", "start": 750.72, "duration": 6.32}, {"text": "Mary Edith Tacila Yanomami,", "start": 753.519, "duration": 5.281}, {"text": "Minister of Foreign Affairs and", "start": 757.04, "duration": 6.239}, {"text": "Cooperation in charge of integration.", "start": 758.8, "duration": 4.479}]